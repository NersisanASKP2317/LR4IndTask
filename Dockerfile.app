# ==============================================================
# БЛОК 1: БАЗОВЫЙ ОБРАЗ
# Указывает, на основе какого образа собирать контейнер
# python:3.11-slim - лёгкий образ Python 3.11 (без лишних пакетов)
# ==============================================================
FROM python:3.11-slim

# ==============================================================
# БЛОК 2: УСТАНОВКА РАБОЧЕЙ ДИРЕКТОРИИ
# Создаёт и переключается в папку /app внутри контейнера
# Все последующие команды будут выполняться относительно этой папки
# ==============================================================
WORKDIR /app

# ==============================================================
# БЛОК 3: КОПИРОВАНИЕ ФАЙЛА ЗАВИСИМОСТЕЙ
# Копирует requirements.txt из текущей папки (хоста) в /app внутри контейнера
# ==============================================================
COPY requirements.txt .

# ==============================================================
# БЛОК 4: УСТАНОВКА ЗАВИСИМОСТЕЙ
# Запускает pip и устанавливает все пакеты из requirements.txt
# --no-cache-dir - отключает кэширование, уменьшая размер образа
# ==============================================================
RUN pip install --no-cache-dir -r requirements.txt

# ==============================================================
# БЛОК 5: КОПИРОВАНИЕ ИСХОДНОГО КОДА
# Копирует app.py из текущей папки в /app внутри контейнера
# (можно добавить и другие файлы: index.html, proxy.py и т.д.)
# ==============================================================
COPY app.py .

# ==============================================================
# БЛОК 6: ОТКРЫТИЕ ПОРТА
# Указывает, что контейнер будет слушать порт 5000
# (это информация для Docker, сам порт открывается при запуске)
# ==============================================================
EXPOSE 5000

# ==============================================================
# БЛОК 7: КОМАНДА ЗАПУСКА
# Выполняется при старте контейнера
# Запускает Python-скрипт app.py
# ==============================================================
CMD ["python", "app.py"]
